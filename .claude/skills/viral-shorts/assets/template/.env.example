# Copie para .env e preencha. O .env nunca vai para o git.

# --- ElevenLabs (narração com IA) ---
ELEVENLABS_API_KEY=
# ID da voz (ElevenLabs > Voices > copie o "Voice ID"). Escolha uma voz que fale bem pt-BR.
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 (padrão, estável) | eleven_v3 (mais expressivo) | eleven_flash_v2_5 (mais barato)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Ajustes finos (0 a 1). Menos stability = mais emoção; mais = mais constante.
ELEVENLABS_STABILITY=0.4
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEED=1.05

# --- Whisper (transcrição da sua própria voz) ---
# tiny | base | small | medium | large-v3-turbo  (medium é um bom equilíbrio para pt-BR)
WHISPER_MODEL=medium
WHISPER_CPP_VERSION=1.7.6

# --- YouTube Data API v3 ---
# Caminho do JSON "OAuth client ID" do tipo "Desktop app" baixado do Google Cloud Console
YT_CLIENT_SECRET=.secrets/client_secret.json
YT_TOKEN_PATH=.secrets/youtube-token.json
# Categoria padrão: 27 = Educação, 28 = Ciência e tecnologia, 24 = Entretenimento
YT_CATEGORY_ID=27
# Fuso usado para exibir datas da fila de publicação
YT_TIMEZONE=America/Sao_Paulo

# --- Render ---
# angle (GPU, padrão local) | swangle (CPU, servidores sem GPU). Usado nos vídeos 3D.
REMOTION_GL=
# Opcional: caminho de um Chrome/Chromium headless já instalado
REMOTION_BROWSER_EXECUTABLE=
