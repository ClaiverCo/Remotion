{
  "name": "viral-shorts-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Projeto Remotion da skill viral-shorts: Shorts/Reels/TikTok explicativos com legendas automáticas.",
  "scripts": {
    "studio": "remotion studio",
    "new": "tsx scripts/new-video.ts",
    "tts": "tsx scripts/tts.ts",
    "tts:kokoro": "tsx scripts/tts.ts --motor kokoro",
    "tts:google": "tsx scripts/tts.ts --motor google",
    "tts:elevenlabs": "tsx scripts/tts.ts --motor elevenlabs",
    "transcribe": "tsx scripts/transcribe.ts",
    "estimate": "tsx scripts/estimate-captions.ts",
    "sync": "tsx scripts/sync-scenes.ts",
    "check-sync": "tsx scripts/check-sync.ts",
    "render": "tsx scripts/render.ts",
    "qa": "tsx scripts/qa-frames.ts",
    "finalize": "tsx scripts/finalize.ts",
    "validate": "tsx scripts/validate-metadata.ts",
    "export": "tsx scripts/export-package.ts",
    "youtube": "tsx scripts/youtube-upload.ts",
    "sfx": "tsx scripts/gen-sfx.ts",
    "test": "tsx --test \"scripts/tests/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.540",
    "@remotion/captions": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "@remotion/install-whisper-cpp": "4.0.540",
    "@remotion/layout-utils": "4.0.540",
    "@remotion/media": "4.0.540",
    "@remotion/paths": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/three": "4.0.540",
    "dotenv": "18.0.9",
    "googleapis": "189.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
